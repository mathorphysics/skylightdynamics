{
  "name": "monorepo-ssr",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@react-router/express": "^8.3.0",
    "express": "^5.2.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.15",
    "lightningcss-linux-x64-gnu": "1.33.0"
  },
  "scripts": {
    "setup": "bun install",
    "dev": "concurrently --kill-others --raw \"npm run dev --prefix apps/web\" \"npm run dev --prefix apps/pocketbase\"",
    "build": "concurrently --raw \"npm run build --prefix apps/web\"",
    "start": "node server.js",
    "lint": "concurrently --raw \"npm run lint --prefix apps/web\"",
    "typecheck": "concurrently --raw \"npm run typecheck --prefix apps/web\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "knip": "^6.32.1"
  },
  "workspaces": [
    "apps/*"
  ]
}